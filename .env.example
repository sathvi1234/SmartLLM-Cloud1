# Frontend (public URL only — never put API keys here)
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Vercel production (either form works; client normalizes /api/v1):
# NEXT_PUBLIC_API_URL=https://smartllm-cloud1-1.onrender.com

# Backend — copy these into a root or backend/.env file (gitignored)
SECRET_KEY=change-me
DATABASE_URL=postgresql://postgres:supersecretpassword@localhost:5432/smartllm
# Comma-separated browser origins (add your exact Vercel URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
XAI_API_KEY=
